{
  "expo": {
    "name": "Reporte Ciudadano",
    "slug": "reporte-ciudadano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reporteciudadano",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.gob.gualeguaychu.reporteciudadano",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ar.gob.gualeguaychu.reporteciudadano",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B4F6C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B4F6C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Reporte Ciudadano usa la camara para sacar la foto del problema que estas reportando.",
          "microphonePermission": "Reporte Ciudadano usa el microfono para que puedas describir el problema hablando, en vez de escribir.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Reporte Ciudadano accede a tus fotos para que puedas adjuntar una imagen que ya sacaste."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Reporte Ciudadano usa tu ubicacion para marcar en el mapa donde esta el problema."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Reporte Ciudadano usa Face ID para que vuelvas a entrar sin escribir la contrasena."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B4F6C"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Reporte Ciudadano usa el microfono para grabar la descripcion hablada del problema."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "REEMPLAZAR_PROJECT_ID"
      }
    }
  }
}
