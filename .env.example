# Copiar a .env (o cargar como secret en EAS) cuando la catedra publique la API.
# Si esta vacio o ausente, los servicios responden con los mocks de src/mocks (ver src/servicios/http.ts).
EXPO_PUBLIC_API_URL=

# Clave de Google Maps para Android. Sin esto react-native-maps muestra el mapa en gris en el APK.
# Se pega en app.json -> android.config.googleMaps.apiKey (o via app.config.ts si lo migramos).
GOOGLE_MAPS_API_KEY_ANDROID=
