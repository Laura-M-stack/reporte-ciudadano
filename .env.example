# Copiar a .env cuando la catedra publique la API.
# Si esta vacio o ausente, los servicios responden con los mocks de src/mocks
# (ver src/servicios/http.ts). .env esta en .gitignore: nunca se commitea.
EXPO_PUBLIC_API_URL=

# Clave de Google Maps para Android. Sin esto el mapa se ve en blanco.
# La inyecta app.config.js en el plugin de react-native-maps; NO va escrita en app.json,
# porque el repositorio es publico y la clave es un secreto.
#
# Para los builds de EAS, ademas de ponerla aca, cargarla como secreto del proyecto:
#   eas secret:create --scope project --name GOOGLE_MAPS_API_KEY_ANDROID --value <la-clave>
#
# Restringirla siempre en Google Cloud a aplicaciones Android, con el paquete
# ar.gob.gualeguaychu.reporteciudadano y la huella SHA-1 del keystore (eas credentials).
GOOGLE_MAPS_API_KEY_ANDROID=
